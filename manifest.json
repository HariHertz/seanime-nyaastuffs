{
  "id": "nekobridge",
  "name": "NekoBridge",
  "description": "A bridge between NekoBT and Seanime!",
  "manifestURI": "https://raw.githubusercontent.com/HariHertz/seanime-nyaastuffs/refs/heads/main/manifest.json",
  "version": "1.0.5",
  "author": "Haris Hertz",
  "type": "anime-torrent-provider",
  "language": "javascript",
  "lang": "en",
  "userConfig": {
    "version": 2,
    "requiresConfig": true,
    "fields": [
      {
        "type": "text",
        "name": "nekobtApiKey",
        "label": "NekoBT API Key",
        "default": ""
      },
      {
        "type": "select",
        "name": "preferredSubtitleLanguage",
        "label": "Preferred Subtitle Language",
        "options": [
          { "value": "pt-br", "label": "Portuguese (Brazil)" },
          { "value": "pt-pt", "label": "Portuguese (Portugal)" },
          { "value": "en", "label": "English" },
          { "value": "es-es", "label": "Spanish (Spain)" },
          { "value": "es-419", "label": "Spanish (Latin American)" },
          { "value": "de", "label": "German" },
          { "value": "fr-fr", "label": "French" },
          { "value": "it", "label": "Italian" },
          { "value": "ja", "label": "Japanese" }
        ],
        "default": "pt-br"
      },
      {
        "type": "switch",
        "name": "preferMultiSub",
        "label": "Prefer Multi-Sub releases",
        "default": "true"
      }
    ]
  },
  "payloadURI": "https://raw.githubusercontent.com/HariHertz/seanime-nyaastuffs/refs/heads/main/provider.js"
}
